# Copy to .env (gitignored) before running docker compose.
# These are LOCAL DEV values only.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=main


# -- Cloudflare R2 Blob Storage (optional -- leave blank for local dev, app falls back to DB) --
# Create a bucket at dash.cloudflare.com > R2 > Create bucket
# Then create an API token with Object Read & Write on that bucket
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=wellqc-las-files

# ── Cloudflare R2 Blob Storage (optional — leave blank for local dev, app falls back to DB) ──
# Create a bucket at dash.cloudflare.com > R2 > Create bucket
# Then create an API token with Object Read & Write on that bucket
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=wellqc-las-files